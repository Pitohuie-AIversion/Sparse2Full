\documentclass[tikz, border=10mm]{standalone}
\usepackage{tikz}
\usetikzlibrary{positioning, calc, arrows.meta, chains, fit, shapes}
\input{nn_blocks.tex}
\begin{document}
\begin{tikzpicture}[
    node distance=1.5cm,
    every node/.style={scale=0.8, transform shape}
]

% Inputs
\node[io] (xt) {$X_t$};
\node[io, above=1.5cm of xt] (ht_prev) {$H_{t-1}$};

% Concat
\node[op, right=of xt] (concat) {Concat};
\draw[arrow] (xt) -- (concat);
\draw[arrow] (ht_prev) -| (concat);

% Conv
\node[conv, right=of concat] (conv) {Gate\\Conv2d};
\draw[arrow] (concat) -- (conv);

% Gates
\node[nntikz_block, right=of conv, label=below:Gates] (gates) {
    \begin{tikzpicture}
        \node[op] (i) {i};
        \node[op, below=0.1cm of i] (f) {f};
        \node[op, below=0.1cm of f] (o) {o};
        \node[op, below=0.1cm of o] (g) {g};
    \end{tikzpicture}
};
\draw[arrow] (conv) -- (gates);

% Cell Update
\node[op, right=of gates] (update) {Cell\\Update};
\draw[arrow] (gates) -- (update);

% Output
\node[io, right=of update] (ht) {$H_t$};
\draw[arrow] (update) -- (ht);

% Recurrent loop visualization
\draw[skip] (ht.east) -- ++(0.5,0) -- ++(0, 2.5) -| (ht_prev.north);

\end{tikzpicture}
\end{document}
