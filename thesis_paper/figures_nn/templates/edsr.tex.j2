{% include 'pnn_header.tex.j2' %}
\def\ConvColor{convcolor}
\def\ResColor{rescolor}
\def\UpColor{upcolor}
\def\OpColor{opcolor}

\begin{document}
\begin{tikzpicture}

% 1. Input (2D Node)
    \node[io] (in) {Input\\LR};

    % 2. Head (3D Conv)
    \path (in.east) ++(3.0,0,0) coordinate (head_pos);

    \pic[shift={(3.0 * {{ dist_scale|default(1.0) }},0,0)}] at (in.east) {RightBandedBox={
        name=head,
        caption=Head,
        xlabel={{ '{' }}"{{ in_ch }}", "{{ n_feats }}"{{ '}' }},
        zlabel=,
        fill=\ConvColor,
        height=20, width=2, depth=20
    }};

    % 3. Body (ResBlocks)
    % Detailed ResBlock 1
    \pic[shift={(3.5 * {{ dist_scale|default(1.0) }},0,0)}] at (head-east) {RightBandedBox={
        name=res1_conv1,
        caption=Conv\\1,
        xlabel={{ '{' }}"{{ n_feats }}", ""{{ '}' }},
        zlabel=,
        fill=\ConvColor,
        height=20, width=2, depth=20
    }};

    \pic[shift={(1.2 * {{ dist_scale|default(1.0) }},0,0)}] at (res1_conv1-east) {Box={
        name=res1_relu,
        caption=ReLU,
        fill=\OpColor,
        height=15, width=1, depth=15
    }};

    \pic[shift={(1.2 * {{ dist_scale|default(1.0) }},0,0)}] at (res1_relu-east) {RightBandedBox={
        name=res1_conv2,
        caption=Conv\\2,
        xlabel={{ '{' }}"{{ n_feats }}", ""{{ '}' }},
        zlabel=,
        fill=\ConvColor,
        height=20, width=2, depth=20
    }};

    % Skip connection for ResBlock 1 (Increased height to avoid overlap)
    \draw[skip] (head-east) -- ++(0, 4, 0) -| (res1_conv2-east);

    \pic[shift={(2.5,0,0)}] at (res1_conv2-east) {Box={
        name=res2,
        caption={{ block_type }}\\2,
        fill=\ResColor,
        height=20, width=4, depth=20
    }};

    \pic[shift={(2.0,0,0)}] at (res2-east) {Box={
        name=res16,
        caption={{ block_type }}\\{{ n_resblocks }},
        fill=\ResColor,
        height=20, width=4, depth=20
    }};

    % 4. Tail (3D Conv)
    \pic[shift={(3.0,0,0)}] at (res16-east) {RightBandedBox={
        name=tail,
        caption=Tail,
        xlabel={ {{ "{" }}{{ n_feats }}, {{ out_ch }}{{ "}" }} },
        zlabel=,
        fill=\ConvColor,
        height=20, width=2, depth=20
    }};

    % 5. Upsampler (3D Block)
    \pic[shift={(3.0,0,0)}] at (tail-east) {Box={
        name=up,
        caption=Upsamp-\\ler,
        fill=\UpColor,
        height=30, width=5, depth=30
    }};

    % 6. Output (2D Node)
    \node[io, right=3.5cm of up-east] (out) {Output\\HR};

% Connections
\draw[arrow] (in) -- (head-west);
\draw[arrow] (head-east) -- (res1_conv1-west);
\draw[arrow] (res1_conv1-east) -- (res1_relu-west);
\draw[arrow] (res1_relu-east) -- (res1_conv2-west);
\draw[arrow] (res1_conv2-east) -- (res2-west);
\draw[arrow] (res2-east) -- (res16-west);
\draw[arrow] (res16-east) -- (tail-west);
\draw[arrow] (tail-east) -- (up-west);
\draw[arrow] (up-east) -- (out);

\end{tikzpicture}
\end{document}
