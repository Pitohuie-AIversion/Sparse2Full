\documentclass[tikz, border=10mm]{standalone}
\usepackage{tikz}
\usetikzlibrary{positioning, calc, arrows.meta, chains, fit, shapes}
\input{nn_blocks.tex}
\begin{document}
\begin{tikzpicture}[
    node distance=1.5cm,
    every node/.style={scale=0.8, transform shape}
]

\node[io] (in) {Input};

% Encoder
\node[conv, right=of in] (enc1) {Enc1};
\node[conv, right=of enc1] (enc2) {Enc2};
\node[conv, right=of enc2] (enc3) {Enc3};

% FNO Bottleneck
\node[nntikz_block, right=of enc3, label=below:FNO Bottleneck] (fno) {
    \begin{tikzpicture}
        \node[op] (fft) {FFT};
        \node[res, right=0.3cm of fft] (w) {Spec\\Weights};
        \node[op, right=0.3cm of w] (ifft) {IFFT};
        \draw[arrow] (fft) -- (w);
        \draw[arrow] (w) -- (ifft);
    \end{tikzpicture}
};

% Decoder
\node[up, right=of fno] (dec3) {Dec3};
\node[up, right=of dec3] (dec2) {Dec2};
\node[up, right=of dec2] (dec1) {Dec1};

\node[io, right=of dec1] (out) {Output};

% Main Flow
\draw[arrow] (in) -- (enc1);
\draw[arrow] (enc1) -- (enc2);
\draw[arrow] (enc2) -- (enc3);
\draw[arrow] (enc3) -- (fno);
\draw[arrow] (fno) -- (dec3);
\draw[arrow] (dec3) -- (dec2);
\draw[arrow] (dec2) -- (dec1);
\draw[arrow] (dec1) -- (out);

% Skips
\draw[skip] (enc3) to[bend left=30] (dec3);
\draw[skip] (enc2) to[bend left=30] (dec2);
\draw[skip] (enc1) to[bend left=30] (dec1);

\end{tikzpicture}
\end{document}
